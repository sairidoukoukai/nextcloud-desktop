+// Retry the existing token check without creating another browser handoff.
+func tokenCheckRequest(ctx context.Context, client *http.Client, req *http.Request, retryDelay time.Duration) (*http.Response, error) {
+	for {
+		resp, err := client.Do(req.Clone(ctx))
+		if err == nil && resp.StatusCode < 500 {
+			return resp, nil
+		}
+		if resp != nil {
+			_ = resp.Body.Close()
+		}
+		timer := time.NewTimer(retryDelay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return nil, ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
